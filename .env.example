# ══════════════════════════════════════════════════════════════════════════════
# IT Ticket Routing Agent — Environment Configuration
# ══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in the required values before running.
# NEVER commit .env to version control.
# ══════════════════════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────────────────────
# asyncpg DSN — used by the FastAPI backend
DATABASE_URL=postgresql+asyncpg://postgres:password@postgres:5432/ticket_routing

# PostgreSQL credentials — used by Docker Compose
POSTGRES_DB=ticket_routing
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# ── Auth / Security ───────────────────────────────────────────────────────────
# Generate a secure key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-this-with-a-secure-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Admin credentials — REQUIRED, no default. Must not be "changeme123".
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# ── LLM Backend ───────────────────────────────────────────────────────────────
# Options: "ollama" (local, requires GPU) | "claude" (Anthropic API, no GPU)
LLM_BACKEND=ollama

# Ollama settings (used when LLM_BACKEND=ollama)
# Start Ollama: docker compose --profile gpu up ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=mistral:7b-instruct
OLLAMA_TIMEOUT=60

# Claude API settings (used when LLM_BACKEND=claude)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001

# ── ML / Embedding ────────────────────────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
EMBEDDING_BATCH_SIZE=32

# ── Classification Thresholds ─────────────────────────────────────────────────
CONFIDENCE_HIGH_THRESHOLD=0.85
CONFIDENCE_LOW_THRESHOLD=0.60
MULTI_DOMAIN_DIFF_THRESHOLD=0.15

# ── RAG Configuration ─────────────────────────────────────────────────────────
RAG_DENSE_WEIGHT=0.70
RAG_BM25_WEIGHT=0.30
RAG_TOP_K=5
RAG_CANDIDATE_POOL=20
MMR_LAMBDA=0.7

# ── Ingestion / Deduplication ─────────────────────────────────────────────────
DEDUP_SIMILARITY_THRESHOLD=0.95
DEDUP_WINDOW_DAYS=7

# ── API ───────────────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=false
RATE_LIMIT_PER_MINUTE=100
CORS_ORIGINS=["http://localhost:4200","http://localhost:3000"]

# ── Monitoring ────────────────────────────────────────────────────────────────
PROMETHEUS_ENABLED=true
GRAFANA_PASSWORD=admin
