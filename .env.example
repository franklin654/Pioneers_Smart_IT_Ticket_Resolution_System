# TicketIQ — environment variable template
# Copy to .env and fill in real values before running `docker compose up`.
# This file is committed; the actual .env is gitignored.

# ---------------------------------------------------------------------------
# Required — docker compose will refuse to start without these
# ---------------------------------------------------------------------------

# PostgreSQL password (any strong random string)
POSTGRES_PASSWORD=change_me_strong_password

# FastAPI admin credentials
ADMIN_PASSWORD=change_me_admin_password

# JWT signing key — minimum 32 characters
JWT_SECRET_KEY=change_me_at_least_32_characters_long_secret

# ---------------------------------------------------------------------------
# LLM backend — choose one
# ---------------------------------------------------------------------------

# "ollama" (default, local) or "claude" (Anthropic API)
LLM_PROVIDER=ollama

# Used when LLM_PROVIDER=ollama
# With GPU profile:  http://ollama:11434
# Without (external): http://host.docker.internal:11434
OLLAMA_BASE_URL=http://ollama:11434

# Used when LLM_PROVIDER=claude (leave blank for ollama)
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Grafana admin password (default: admin — change for any non-local deployment)
GRAFANA_PASSWORD=admin
