# TicketIQ Frontend — Environment Configuration
# Copy to .env and adjust.
# In development, Vite proxies /api/* and /ws/* to BACKEND_URL automatically.

# FastAPI backend URL (Vite proxy target)
BACKEND_URL=http://localhost:8000

# ── CORS note ─────────────────────────────────────────────────────────────────
# The Vite dev server runs on port 5173 by default.  The backend's CORS allow-
# list must include that origin or browser requests will be blocked.
# In backend/.env set:
#   CORS_ORIGINS=["http://localhost:5173","http://localhost:4200","http://localhost:3000"]
