{
  "title": "TicketIQ — Pipeline Monitoring",
  "uid": "ticketiq-main",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Tickets Processed / min",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 7 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(ticketiq_tickets_processed_total[1m]) * 60",
          "legendFormat": "{{routing_decision}} / {{category}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "fillOpacity": 10 } }
      }
    },
    {
      "id": 2,
      "title": "Routing Distribution (total)",
      "type": "piechart",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 7 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum by (routing_decision) (ticketiq_tickets_processed_total)",
          "legendFormat": "{{routing_decision}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Awaiting Review Total",
      "type": "stat",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 7 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "ticketiq_awaiting_review_total",
          "legendFormat": "Awaiting Review"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 50 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Pipeline Duration p50 / p95 / p99",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 7, "w": 12, "h": 7 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.50, rate(ticketiq_ticket_duration_seconds_bucket[5m]))",
          "legendFormat": "p50"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, rate(ticketiq_ticket_duration_seconds_bucket[5m]))",
          "legendFormat": "p95"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.99, rate(ticketiq_ticket_duration_seconds_bucket[5m]))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    },
    {
      "id": 5,
      "title": "Classification Confidence (median)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 7, "w": 12, "h": 7 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.50, rate(ticketiq_classification_confidence_bucket[5m]))",
          "legendFormat": "p50 confidence"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.10, rate(ticketiq_classification_confidence_bucket[5m]))",
          "legendFormat": "p10 confidence"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.60 },
              { "color": "green", "value": 0.85 }
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "title": "LLM Quality Score (median)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 14, "w": 12, "h": 7 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.50, rate(ticketiq_llm_quality_score_bucket[5m]))",
          "legendFormat": "p50 quality"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.10, rate(ticketiq_llm_quality_score_bucket[5m]))",
          "legendFormat": "p10 quality"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 1,
          "max": 5,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 3.0 },
              { "color": "green", "value": 3.5 }
            ]
          }
        }
      }
    },
    {
      "id": 7,
      "title": "Auto-Resolve Rate",
      "type": "stat",
      "gridPos": { "x": 12, "y": 14, "w": 6, "h": 7 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(ticketiq_tickets_processed_total{routing_decision=\"auto_resolved\"}) / sum(ticketiq_tickets_processed_total)",
          "legendFormat": "Auto-resolve rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.3 },
              { "color": "green", "value": 0.5 }
            ]
          }
        }
      }
    },
    {
      "id": 8,
      "title": "Awaiting Review Rate",
      "type": "stat",
      "gridPos": { "x": 18, "y": 14, "w": 6, "h": 7 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(ticketiq_tickets_processed_total{routing_decision=\"awaiting_review\"}) / sum(ticketiq_tickets_processed_total)",
          "legendFormat": "Awaiting review rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.2 },
              { "color": "red", "value": 0.4 }
            ]
          }
        }
      }
    }
  ]
}
