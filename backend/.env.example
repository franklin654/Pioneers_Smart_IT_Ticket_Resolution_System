# Copy to .env and fill in real values. Never commit the real .env file.

# --- App ---
ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=INFO

# --- Database ---
DATABASE_URL=postgresql+asyncpg://ticketiq:ticketiq@localhost:5432/ticketiq
DB_POOL_SIZE=10

# --- Auth ---
# Required at startup — process refuses to start if unset (audit fix H2).
ADMIN_PASSWORD=
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- LLM ---
LLM_PROVIDER=ollama               # ollama | claude
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral:7b
ANTHROPIC_API_KEY=

# --- Classification thresholds ---
CONFIDENCE_HIGH_THRESHOLD=0.85
CONFIDENCE_LOW_THRESHOLD=0.60
MULTI_DOMAIN_DIFF_THRESHOLD=0.15

# --- Routing / quality gate ---
LLM_QUALITY_THRESHOLD=3.5

# --- Ingestion ---
DEDUP_SIMILARITY_THRESHOLD=0.95

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
